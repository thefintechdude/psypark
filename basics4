#window functions
from pyspark.sql.window import Window
from pyspark.sql.functions import row_number, max, col, desc, asc

# select *,max(salary) over (partition by department_id order bu salary desc) as ranked from employee where ranked = 2 

window_spec = Window.partitionBy(col("dept_id")).orderBy(col("salary").desc())
max_func = max(col("salary")).over(window_spec)
emp_1 = emp.withColumn("max_salary",max_func)
emp_1.show()

# select *,row_number() over(partition by department_id order by salary desc) as ranked from employee where rn =2 
window_spec = Window.partitionBy(col("dept_id")).orderBy(col("salary").desc())
ranked = row_number().over(window_spec)
emp_2 = emp.withColumn("ranked",ranked).where("ranked=2")
emp_2.show()

#using expr
from pyspark.sql.functions import expr 
emp_3 = emp.withColumn("ranked",expr("row_number() over(partition by dept_id order by salary desc)")).where("ranked=2")
emp_3.show()




